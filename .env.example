# Bu dosyayı .env olarak kopyala: cp .env.example .env
# .env asla commit'lenmez (.gitignore içinde).

NODE_ENV=development

# docker-compose.yml içindeki Postgres'e bağlanır.
DATABASE_URL=postgres://saas:saas@localhost:5432/saas

# Uygulamanın dışarıdan görünen adresi (e-posta linkleri, OAuth dönüşü için).
APP_URL=http://localhost:3000

# Oturum çerezlerini imzalamak için gizli anahtar, en az 32 karakter.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=bunu-mutlaka-degistir-en-az-otuz-iki-karakter
